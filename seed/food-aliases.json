  "_conventions": {
    "purpose": "Maps a food string as written on the paper sheet to a canonical foodId. Substitution groups reference foodIds, never raw strings.",
    "matching": "EXACT match after trim + lowercase + whitespace collapse. No stemming, no plural rules, no token dropping, no fuzzy distance.",
    "null": "Deliberately excluded - a seasoning, garnish or negligible-macro item. null is a real answer and means 'reviewed, not a swap candidate'. Anything absent from this file entirely is UNKNOWN and shows up in the coverage report.",
    "why": "'pepper' (cracked black pepper, a seasoning) and 'peppers' (bell peppers, a vegetable) both appear in the plans. Any plural-stemming normalizer merges them, silently turning a seasoning into a vegetable inside a number the member is asked to trust.",
    "status": "placeholder - pending nutritionist review"
  },

